# --- IA : Claude (Anthropic) ---
ANTHROPIC_API_KEY=
# Optionnel : par défaut claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = passer par les Edge Functions Supabase (par défaut : logique locale du serveur Express)
USE_EDGE_FUNCTIONS=false

# --- Cal.com (clé secrète : jamais en base, jamais dans le code) ---
CAL_API_KEY=
CAL_USERNAME=
CAL_EVENT_SLUG=visite-d-estimation-a-domicile
# Recommandé : fixe l'événement sans dépendre de l'auto-détection
CAL_EVENT_TYPE_ID=
# Secret du webhook Cal.com (Settings > Developer > Webhooks) -> POST /api/webhooks/cal
CAL_WEBHOOK_SECRET=
# true UNIQUEMENT en local pour simuler une réservation sans Cal.com
CAL_DEV_MODE=false

# --- Conseiller affiché par l'assistant ---
AGENT_NAME="Céline Levrat"
AGENT_AGENCY="NOVEA Immobilier"
AGENT_PHONE="06 03 58 03 16"
AGENT_CITY=Lyon
# Durée de la visite en minutes : doit être identique à l'événement Cal.com
VISIT_MINUTES=60

# --- Accès conseiller (OBLIGATOIRE pour ouvrir /agent) ---
# Mot de passe de l'espace conseiller (8 caractères minimum). Vérifié côté serveur uniquement.
AGENT_PASSWORD=
# Chaîne aléatoire longue qui signe les sessions (ex: openssl rand -hex 32). Sans elle, les connexions sautent à chaque redémarrage.
SESSION_SECRET=

# --- Ventes réelles (DVF) : aucune clé nécessaire ---
# Communes dont les ventes sont préchargées au démarrage (codes INSEE, Lyon 1er-9e = 69381-69389, Villeurbanne = 69266)
DVF_PREWARM=69381,69382,69383,69384,69385,69386,69387,69388,69389,69266

# --- Envoi d'e-mails (relances) : Resend (https://resend.com) ou Brevo ---
RESEND_API_KEY=
# Adresse expéditeur : doit appartenir à un domaine vérifié chez Resend (ex: celine@votre-domaine.fr)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Céline Levrat"
# Les réponses des clients arrivent ici (la vraie boîte de Céline)
MAIL_REPLY_TO=
# Optionnel : copie cachée de chaque e-mail envoyé
MAIL_BCC=
# Adresse publique du site : sert au lien de désinscription obligatoire (Render la fournit déjà, sinon à renseigner)
APP_URL=https://estim-o.onrender.com
# Plafond de sécurité d'e-mails par 24 h
MAIL_DAILY_LIMIT=50
# Optionnel : secret pour qu'un service externe (cron-job.org) déclenche les envois sur une instance qui s'endort
CRON_SECRET=

PORT=3000

# Suivi Google Ads (variables lues au BUILD : à définir sur Render avant le déploiement). Laisser vide = aucun suivi, aucun bandeau.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=
VITE_GOOGLE_ADS_BOOKING_LABEL=
